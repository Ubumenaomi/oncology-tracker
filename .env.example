# Browser-safe Firebase configuration (optional because the app has a fallback project config)
VITE_FIREBASE_API_KEY=

# Server-only Notion integration
NOTION_TOKEN=
NOTION_DATA_SOURCE_ID=105bb19a-c0c2-8160-aaab-000b49de9e79
NOTION_VERSION=2025-09-03

# At least one access policy is required by /api/notion-library.
# Comma-separated Firebase Auth values; prefer UID because it remains stable if email changes.
NOTION_ALLOWED_UIDS=
NOTION_ALLOWED_EMAILS=
